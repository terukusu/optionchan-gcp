  },
  {
    "name": "page_updated_at",
    "type": "TIMESTAMP",
    "mode": "NULLABLE",
    "description": "この行を取ったページの最終更新時刻。created_at は 1 限月ページの更新時刻に揃えるので、2 限月の行だけ値が違いうる"
  },
  {
    "name": "price_time_raw",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "ページの約定日時の表示（MM/DD HH:MM、年なし）。price_time の元。移行行（#12）で #4 の補正をした行（parser_version = legacy-fix4-1）は補正前の price_time（YYYY-MM-DD HH:MM:SS）"
  },
  {
    "name": "ingest_run_id",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "取り込み実行の ID（UUID4。旧系から移した行（#12）は legacy-<created_at の UTC, YYYYMMDDTHHMMSSZ>）。ingest_runs と結合して最新版を選ぶ"
  },
  {
    "name": "parser_version",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "解析コードの版（例 ingest-1）"
  },
  {
    "name": "source_object",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "元の生 HTML（gs://<bucket>/<name>#<generation>）"
  }
]
