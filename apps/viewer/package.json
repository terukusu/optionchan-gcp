{
  "name": "optionchan-viewer-vendor",
  "private": true,
  "description": "ビューアーのブラウザ用ライブラリ（ビルド時に static/vendor/ へコピーして同梱する。CDN は使わない）",
  "license": "UNLICENSED",
  "dependencies": {
    "chart.js": "4.5.1",
    "chartjs-adapter-luxon": "1.3.1",
    "chartjs-chart-financial": "0.2.1",
    "luxon": "3.7.2"
  },
  "scripts": {
    "vendor": "mkdir -p src/optionchan_viewer/static/vendor && cp node_modules/chart.js/dist/chart.umd.min.js node_modules/luxon/build/global/luxon.min.js node_modules/chartjs-adapter-luxon/dist/chartjs-adapter-luxon.umd.min.js node_modules/chartjs-chart-financial/dist/chartjs-chart-financial.min.js src/optionchan_viewer/static/vendor/"
  }
}
